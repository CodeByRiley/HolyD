# Shell scripts must keep LF endings so a Windows checkout can still run them
# under bash.
*.sh text eol=lf

# .hd scripts get copied into a FAT image and read by holyd's lexer. The
# lexer treats \r as whitespace so CRLF parses, but pinning them keeps the
# bytes on the image identical to the bytes in the repository.
*.hd text eol=lf

# Sources, so a diff between this repository and a TOS checkout is about
# content rather than line endings.
*.c text eol=lf
*.h text eol=lf
Makefile text eol=lf

# Binary payloads: never touch, never diff as text.
*.png binary
*.exe binary
*.elf binary
