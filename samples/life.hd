/* life.hd , Conway's Life on the windowing FFI.
 *
 *     holyd samples/life.hd
 *
 * SPACE pauses and resumes, R reseeds, S single-steps while paused, ESC or
 * the close button quits.
 *
 * Three things here are worth reading rather than skimming.
 *
 * Allocating a grid. There is no MAlloc and no way to ask for an array of
 * N zeroes, so MakeGrid starts from [0] and doubles it with ~ until it is
 * the right size. Ten doublings give 1024 cells; building it by appending
 * one cell at a time would copy the whole array 1024 times instead of ten.
 *
 * No 2D arrays. The grid is flat and indexed y * W + x, which is what At
 * and Set exist to hide.
 *
 * Counting neighbours without &&. The obvious loop wants to skip the centre
 * cell, which needs `dx != 0 && dy != 0`. Instead this sums all nine cells
 * and subtracts the centre afterwards , same answer, no operator needed.
 */

I64 W = 32;
I64 H = 32;
I64 CELL = 12;
I64 HEADER_H = 28;

I64 Mod(I64 n, I64 d) {
    return n - (n / d) * d;
}

/* 2^power cells, all zero. Doubling keeps this to `power` allocations. */
I64[] MakeGrid(I64 power) {
    I64[] g = [0];
    for (I64 i = 0; i < power; i++) {
        g = g ~ g;
    }
    return g;
}

I64 At(I64[] g, I64 x, I64 y) {
    return g[y * W + x];
}

U0 Set(I64[] g, I64 x, I64 y, I64 v) {
    g[y * W + x] = v;
}

U0 Clear(I64[] g) {
    for (I64 i = 0; i < g.length; i++) {
        g[i] = 0;
    }
}

/* Counts the number of live cells around (x, y). */
I64 Neighbours(I64[] g, I64 x, I64 y) {
    I64 n = 0;

    for (I64 dy = 0 - 1; dy <= 1; dy++) {
        for (I64 dx = 0 - 1; dx <= 1; dx++) {
            I64 nx = Mod(x + dx + W, W);
            I64 ny = Mod(y + dy + H, H);
            n = n + At(g, nx, ny);
        }
    }

    /* That counted the centre too. Subtracting it is cheaper than the
     * conditional that would have skipped it. */
    return n - At(g, x, y);
}

/* Updates the grid. */
U0 Step(I64[] cur, I64[] nxt) {
    for (I64 y = 0; y < H; y++) {
        for (I64 x = 0; x < W; x++) {
            I64 n = Neighbours(cur, x, y);
            I64 next = 0;

            if (At(cur, x, y) == 1) {
                if (n == 2) next = 1;
                if (n == 3) next = 1;
            } else {
                if (n == 3) next = 1;
            }

            Set(nxt, x, y, next);
        }
    }
}

U0 Copy(I64[] from, I64[] into) {
    for (I64 i = 0; i < from.length; i++) {
        into[i] = from[i];
    }
}

/* Sets the initial state of the grid. */
U0 Seed(I64[] g) {
    Clear(g);

    Set(g, 2, 1, 1);
    Set(g, 3, 2, 1);
    Set(g, 1, 3, 1);
    Set(g, 2, 3, 1);
    Set(g, 3, 3, 1);

    Set(g, 12, 6, 1);
    Set(g, 13, 6, 1);
    Set(g, 14, 6, 1);

    Set(g, 24, 18, 1);
    Set(g, 24, 19, 1);
    Set(g, 24, 20, 1);

    Set(g, 6, 22, 1);
    Set(g, 7, 22, 1);
    Set(g, 6, 23, 1);
    Set(g, 7, 23, 1);
}

I64 Population(I64[] g) {
    I64 n = 0;
    foreach (v; g) {
        n = n + v;
    }
    return n;
}

U0 DrawFrame(I64[] g, I64 win, I64 gen, I64 paused) {
    WinClear(win, COLOR_BLACK);

    WinFillRect(win, 0, 0, WinWidth(win), HEADER_H, COLOR_GRAY);
    WinBevel(win, 0, 0, WinWidth(win), HEADER_H, 0x00C0C0C0, 0x00202020, 1);

    auto label = "gen " ~ Str(gen) ~ "   pop " ~ Str(Population(g));
    if (paused == 1) {
        label = label ~ "   [paused]";
    }
    WinDrawText(win, 8, 8, label, COLOR_BLACK, 1);

    for (I64 y = 0; y < H; y++) {
        for (I64 x = 0; x < W; x++) {
            if (At(g, x, y) == 1) {
                WinFillRect(win, x * CELL, HEADER_H + y * CELL,
                            CELL - 1, CELL - 1, COLOR_GREEN);
            }
        }
    }
}

U0 main() {
    I64 win = WinCreate(W * CELL, H * CELL + HEADER_H, "HolyD , Life",
                        WIN_STATUSBAR);
    if (win < 0) {
        PrintLn("life: WinCreate failed , is winman running?");
        return -1;
    }

    /* 32 * 32 is 1024, which is 2^10. */
    I64[] cur = MakeGrid(10);
    I64[] nxt = MakeGrid(10);
    Seed(cur);

    WinSetStatus(win, "space pauses  r reseeds  s steps  esc quits");

    I64 gen = 0;
    I64 paused = 0;
    I64 running = 1;

    while (running == 1) {
        I64 advance = 0;
        I64 ev = WinPollEvent(win);

        while (ev != EV_NONE) {
            if (ev == EV_KEY_DOWN) {
                I64 key = WinEventKey();
                if (key == KEY_ESC) {
                    running = 0;
                } else if (key == KEY_SPACE) {
                    if (paused == 1) {
                        paused = 0;
                    } else {
                        paused = 1;
                    }
                } else if (key == KEY_R) {
                    Seed(cur);
                    gen = 0;
                } else if (key == KEY_S) {
                    /* Single step, so a pattern can be read one
                     * generation at a time. */
                    advance = 1;
                }
            } else if (ev == EV_QUIT) {
                running = 0;
            }

            ev = WinPollEvent(win);
        }

        if (paused == 0) advance = 1;

        if (advance == 1) {
            Step(cur, nxt);
            Copy(nxt, cur);
            gen++;
        }

        DrawFrame(cur, win, gen, paused);
        WinInvalidate(win);

        Sleep(90);
    }

    WinDestroy(win);
    PrintLn("life: stopped at generation ", gen);
    return 0;
}
