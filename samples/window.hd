U0 main() {
  I64 win = WinCreate(400, 300);

  if (win < 0) {
    PrintLn("Failed to create window!");
    return -1;
  }
  WinSetStatus(win, "ready");
	I64 running = 1;

  while (running) {
    I64 ev = WinPollEvent(win);
		while (ev != EV_NONE) {
			if (ev == EV_KEY_DOWN) {
				I64 key = WinEventKey();
				if (key == KEY_ESC) {
                    running = 0;
        }
			} else if (ev == EV_QUIT) {
        running = 0;
      }
			ev = WinPollEvent(win);
		}

  	WinDrawText(win, 50, 50, "Hello from HolyD GUI!");
  	WinInvalidate(win);
    Sleep(16);

  }
  WinDestroy(win);
  PrintLn("gui: done");
  return 0;
}

